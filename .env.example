# Copy to .env (scripts\setup-local.cmd does this automatically).
# Do not commit .env.
 
# local  : data/items.json (default, no Azure needed)
# blob   : Azure Blob Storage (items.json)      -> pattern A
# cosmos : Azure Cosmos DB for NoSQL            -> pattern B
STORAGE_MODE=local
 
# pattern A (set by scripts\use-azure-storage.cmd from terraform output)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=
 
# pattern B (set by scripts\use-azure-storage.cmd from terraform output)
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=
AZURE_COSMOS_CONTAINER=
 
# Generated by scripts\setup-local.cmd
SECRET_KEY=


